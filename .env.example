PORT=3000
# Central server base URL. If CENTRAL_URL_FILE exists it wins at request time (quick tunnels rotate).
NEXT_PUBLIC_CENTRAL_SERVER_URL=https://central.example.com
CENTRAL_URL_FILE=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Places API (New) + Routes API, server side only
GOOGLE_MAPS_API_KEY=xxx
# Internal tileserver-gl (OpenMapTiles), proxied at /tiles
TILESERVER_URL=http://tiles:8080
